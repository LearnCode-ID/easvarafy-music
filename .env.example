# Supabase: auth, profiles/private media, streaks and personal playlists/likes.
# Music catalogue/audio/lyrics keep using the existing API routes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: absolute origin of the deployed web build.
# Only needed for the Android APK build (static export), because the APK has no
# server of its own and calls the web build's /api/music/* routes.
# Example: https://easvarafy.vercel.app
NEXT_PUBLIC_API_BASE=

# Set to true only for the Capacitor APK build (`npm run build:static`).
# NEXT_STATIC_EXPORT=true

# Canonical public HTTPS web origin for profile sharing, required for APK.
NEXT_PUBLIC_APP_URL=https://easvarafy-music.vercel.app
