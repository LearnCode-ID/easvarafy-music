# Supabase: auth, profiles/private media, streaks and personal playlists/likes.
# Music catalogue/audio/lyrics keep using the existing API routes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: absolute origin of the deployed web build.
# Only needed for the Android APK build (static export), because the APK has no
# server of its own and calls the web build's /api/music/* routes.
# Example: https://easvarafy.vercel.app
NEXT_PUBLIC_API_BASE=

# Set to true only for the Capacitor APK build (`npm run build:static`).
# NEXT_STATIC_EXPORT=true

# Canonical public HTTPS web origin for profile sharing, required for APK.
NEXT_PUBLIC_APP_URL=https://easvarafy-music.vercel.app

# Optional licensed single-file downloads (server only; never NEXT_PUBLIC).
# Enable ONLY after confirming redistribution/download rights for these files.
# YouTube IFrame/catalogue access is NOT download permission.
AUDIO_DOWNLOADS_ENABLED=false
# Final public HTTPS URL, no redirects/private networks. ID is the YouTube catalogue ID.
# Multiple templates may be comma-separated. Do not use expiring static signed URLs.
AUDIO_SOURCE_URL_TEMPLATE=
# Optional operator-owned public Storage files <videoId>.mp3/.m4a/.opus/.webm.
# No audio is uploaded automatically. Public bucket only if distribution is authorized.
AUDIO_STORAGE_BUCKET=offline-audio
AUDIO_STORAGE_DISABLED=true
